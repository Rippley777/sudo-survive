    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
